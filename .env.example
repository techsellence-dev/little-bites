ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5-5   # needs vision for screenshot posts

# Public HTTPS address of the app. Used in password-reset and verification email links.
APP_URL=http://localhost:3000

# Email (password reset + verification). Without a key, emails are printed to the server log (dev only).
# RESEND_API_KEY=re_xxx
# MAIL_FROM=Little Bites <hello@yourdomain.com>

# PORT=3000
# DATA_DIR=./data          # SQLite database file lives here; use a persistent disk in production
# TRUST_PROXY=1            # set when behind an HTTPS proxy/host (Render, Fly, Railway, Caddy, nginx)
# COOKIE_SECURE=1          # force Secure cookies
